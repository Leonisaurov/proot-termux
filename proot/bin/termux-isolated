#!/data/data/com.termux/files/usr/bin/bash
# termux-isolated — Termux REAL dentro de proot con aislamiento (sandbox).
# Patrón de alpine_rootfs: args en variable, un flag por línea, binds estáticos.

# Paths del host (definidos ANTES de exportar PREFIX=/usr dentro del sandbox)
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
TERMUX_PREFIX=/data/data/com.termux/files/usr
TERMUX_ROOT=/data/data/com.termux/files

# Ayuda
if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    cat >&2 <<'EOF'
uso: termux-isolated [opciones] [comando...]

  sin argumentos   shell interactivo configurado en Termux aislado
  --with-sys       bind /sys:/sys (opcional)
  --with-storage   Expone el almacenamiento interno en $HOME/storage,
                   /storage/emulated/0 y /sdcard (opt-in; por defecto se
                   ocultan con :mask)
  --no-proc-isolated
                   Desactiva el aislamiento de /proc
  --proc-isolated  Activa el aislamiento estricto de /proc (puede ocultar
                   la ruta del PTY a programas TUI; opt-in)
  --               Fin de opciones; todo lo siguiente se ejecuta como comando
  --as-root        --change-id=0:0 (simula root)
  --rw-dir <path>  Solo <path> es escribible; el resto del sandbox es de solo lectura (apt/pkg no funcionan en este modo)
  --termux-paths  Usa los paths reales de Termux (/data/data/com.termux/files/...) en vez de la jerarquía Linux (/usr, /home); misma seguridad extra
  --proot-arg <arg>
                   Pasa un argumento literal a proot (repetible; usar antes de --)
  --proot-args "<args>"
                   Pasa varios argumentos separados por espacios a proot
                   (repetible; para valores con espacios usa --proot-arg)
  --cwd <path>     Fija el cwd explícitamente. Acepta una ruta host de Termux
                   (por ejemplo "$PWD") o una ruta guest (/home, /tmp, ...)
  --verbose        Muestra información del wrapper y del aislamiento
  --as <nombre>    Muestra <nombre> en whoami/id (estético; el uid real no cambia). Excluyente con --as-root.

Ejemplos:
  termux-isolated
  termux-isolated curl -s https://example.com
  termux-isolated -- sh -c 'echo "--as-root es un argumento del comando"'
  termux-isolated --as-root apt update
EOF
    exit 0
fi

# Separa las opciones del wrapper del comando a ejecutar
cmd=""
extra=""
PROOT_ARGS=()
CWD_OVERRIDE=""
RW_DIR=""
TERMUX_PATHS=0
AS_USER=""
AS_ROOT=0
VERBOSE=0
PROC_ISOLATED=0
WITH_STORAGE=0
# Termux chsh persists the selected shell here.  Prefer that source over the
# inherited variable: env -i and callers such as fish need not export SHELL.
CONFIGURED_SHELL=""
if [ -L "$TERMUX_ROOT/home/.termux/shell" ]; then
    CONFIGURED_SHELL=$(readlink "$TERMUX_ROOT/home/.termux/shell")
fi
if [ -z "$CONFIGURED_SHELL" ]; then
    CONFIGURED_SHELL="${SHELL:-$TERMUX_PREFIX/bin/bash}"
fi
COMMAND_MODE=0
arg_count=0
while [ "$#" -gt 0 ]; do
    arg="$1"

    # Desde aquí todos los argumentos pertenecen literalmente al comando,
    # aunque coincidan con opciones de este wrapper.
    if [ "$COMMAND_MODE" = "1" ]; then
        if [ "$arg_count" -eq 0 ]; then
            cmd="$arg"
        else
            cmd+=" $(printf '%q' "$arg")"
        fi
        arg_count=$((arg_count + 1))
        shift
        continue
    fi

    case "$arg" in
        --)             COMMAND_MODE=1; shift ;;
        --with-sys)     extra="$extra --bind=/sys:/sys"; shift ;;
        --with-storage) WITH_STORAGE=1; shift ;;
        --no-proc-isolated) PROC_ISOLATED=0; shift ;;
        --proc-isolated) PROC_ISOLATED=1; shift ;;
        --as-root)      AS_ROOT=1; extra="$extra --change-id=0:0"; shift ;;
        --termux-paths) TERMUX_PATHS=1; shift ;;
        --verbose)      VERBOSE=1; shift ;;
        --proot-arg)
            shift
            if [ "$#" -eq 0 ]; then
                echo "error: --proot-arg requiere un valor" >&2
                exit 1
            fi
            PROOT_ARGS+=("$1")
            shift
            ;;
        --proot-arg=*)
            PROOT_ARGS+=("${arg#--proot-arg=}")
            shift
            ;;
        --proot-args)
            shift
            if [ "$#" -eq 0 ]; then
                echo "error: --proot-args requiere una cadena de argumentos" >&2
                exit 1
            fi
            # Comodidad para --proot-args "--net-policy deny". La forma
            # singular conserva exactamente un argumento, incluidos espacios.
            read -r -a proot_arg_words <<< "$1"
            if [ "${#proot_arg_words[@]}" -eq 0 ]; then
                echo "error: --proot-args no puede estar vacío" >&2
                exit 1
            fi
            PROOT_ARGS+=("${proot_arg_words[@]}")
            shift
            ;;
        --proot-args=*)
            proot_args_value="${arg#--proot-args=}"
            read -r -a proot_arg_words <<< "$proot_args_value"
            if [ "${#proot_arg_words[@]}" -eq 0 ]; then
                echo "error: --proot-args no puede estar vacío" >&2
                exit 1
            fi
            PROOT_ARGS+=("${proot_arg_words[@]}")
            shift
            ;;
        --cwd)
            shift
            if [ "$#" -eq 0 ]; then
                echo "error: --cwd requiere un path guest" >&2
                exit 1
            fi
            CWD_OVERRIDE="$1"
            shift
            ;;
        --as=*)
            AS_USER="${arg#--as=}"
            shift ;;
        --as)
            shift
            if [ "$#" -eq 0 ]; then
                echo "error: --as requiere un nombre (ej. --as pepe)" >&2
                exit 1
            fi
            AS_USER="$1"
            shift
            ;;
        --rw-dir)
            # Consume UN argumento extra: el path GUEST del dir escribible
            shift
            if [ "$#" -eq 0 ]; then
                echo "error: --rw-dir requiere un path (ej. --rw-dir /tmp)" >&2
                exit 1
            fi
            RW_DIR="$1"
            shift
            ;;
        *)
            # 1 argumento no-opción: el usuario ya citó el script completo (literal).
            # 2+ argumentos: cita cada token con %q para preservar el quoting.
            if [ "$arg_count" -eq 0 ]; then
                cmd="$arg"
            else
                cmd+=" $(printf '%q' "$arg")"
            fi
            arg_count=$((arg_count + 1))
            shift
            ;;
    esac
done
cmd="${cmd# }"

# --as <nombre>: estético (whoami/id muestran <nombre>). Bind de un
# /etc/passwd personalizado (reemplaza la línea del uid real del usuario) +
# env USER/LOGNAME. OJO: en Android/bionic getpwuid() NO lee /etc/passwd
# (genera u0_aXXX programáticamente) — el bind se aplica igual (visible en
# cat /etc/passwd) pero whoami/id reales pueden seguir mostrando el nombre
# del sistema; USER/LOGNAME sí funcionan.
if [ -n "$AS_USER" ]; then
    case "$AS_USER" in
        *[!a-zA-Z0-9_-]*)
            echo "error: --as solo admite caracteres alfanuméricos, _ y -" >&2
            exit 1 ;;
    esac
    if [ "$AS_ROOT" = "1" ]; then
        echo "error: --as y --as-root son mutuamente excluyentes" >&2
        exit 1
    fi
    AS_UID=$(id -u)
    AS_GID=$(id -g)
    AS_PASSWD="$TMPDIR/ti-passwd-$AS_USER"
    AS_ENTRY="$AS_USER:x:$AS_UID:$AS_GID:Termux User:/data/data/com.termux/files/home:/data/data/com.termux/files/usr/bin/bash"
    if [ -f "$PREFIX/etc/passwd" ] && cp "$PREFIX/etc/passwd" "$AS_PASSWD" 2>/dev/null; then
        if grep -q "^[^:]*:[^:]*:$AS_UID:" "$AS_PASSWD"; then
            # Reemplaza la línea con el uid real (no rompe otras entradas)
            sed -i "s|^[^:]*:[^:]*:$AS_UID:.*|$AS_ENTRY|" "$AS_PASSWD"
        else
            echo "$AS_ENTRY" >> "$AS_PASSWD"
        fi
    else
        echo "$AS_ENTRY" > "$AS_PASSWD"
    fi
    passwd_bind="--bind=$AS_PASSWD:/etc/passwd"
    as_env="USER=$AS_USER LOGNAME=$AS_USER"

    # Shims whoami/id: bionic genera u0_aXXX sin consultar /etc/passwd, así
    # que para que whoami/id muestren <AS_USER> se antepone un dir de shims
    # al PATH del sandbox. El id real se invoca por ruta absoluta GUEST y su
    # salida se reescribe (el nombre real del uid -> <AS_USER>). El dir se
    # crea bajo $PREFIX/tmp: en jerárquico es el guest /tmp (bind /tmp:/tmp),
    # en termux-paths el guest $PREFIX/tmp (bind directo usr).
    AS_UID_NAME=$(id -un)
    if [ "$TERMUX_PATHS" = "1" ]; then
        shim_bash="$TERMUX_PREFIX/bin/bash"
        real_id="$TERMUX_PREFIX/bin/id"
        shim_path="$TERMUX_PREFIX/tmp/ti-bin-$AS_USER"
    else
        shim_bash="/usr/bin/bash"
        real_id="/usr/bin/id"
        shim_path="/tmp/ti-bin-$AS_USER"
    fi
    mkdir -p "$PREFIX/tmp/ti-bin-$AS_USER"
    cat > "$PREFIX/tmp/ti-bin-$AS_USER/whoami" <<EOF
#$shim_bash
echo $AS_USER
EOF
    cat > "$PREFIX/tmp/ti-bin-$AS_USER/id" <<EOF
#$shim_bash
exec $real_id "\$@" | sed 's/$AS_UID_NAME/$AS_USER/g'
EOF
    chmod +x "$PREFIX/tmp/ti-bin-$AS_USER/whoami" "$PREFIX/tmp/ti-bin-$AS_USER/id"
else
    passwd_bind=""
    as_env=""
fi

# Android internal storage is never exposed by default.  Keep the visible
# mount points present but deny traversal/content access with :mask.  This is
# deliberately implemented as ordinary bindings so it also covers symlink
# based access through $HOME/storage without a consumer-side shadow table.
STORAGE_HOME_HOST="$TERMUX_ROOT/home/storage"
if [ "$TERMUX_PATHS" = "1" ]; then
    STORAGE_HOME_GUEST="$TERMUX_ROOT/home/storage"
else
    STORAGE_HOME_GUEST="/home/storage"
fi

storage_binds=""
add_storage_bind() {
    local host=$1 guest=$2 mode=${3:-}
    if [ -e "$host" ]; then
        storage_binds="$storage_binds --bind=$host:$guest${mode:+:$mode}"
    elif [ "$WITH_STORAGE" = "1" ]; then
        echo "warning: storage path unavailable, bind skipped: $host" >&2
    fi
}

if [ "$WITH_STORAGE" = "1" ]; then
    add_storage_bind "$STORAGE_HOME_HOST" "$STORAGE_HOME_GUEST"
    add_storage_bind /storage/emulated/0 /storage/emulated/0
    add_storage_bind /storage/self/primary /storage/self/primary
    add_storage_bind /storage/emulated/0 /sdcard
else
    add_storage_bind "$STORAGE_HOME_HOST" "$STORAGE_HOME_GUEST" mask
    add_storage_bind /storage/emulated/0 /storage/emulated/0 mask
    add_storage_bind /storage/self/primary /storage/self/primary mask
    add_storage_bind /storage/emulated/0 /sdcard mask
fi

# Modo estricto (--rw-dir): traduce el path del dir RW a su par host/guest.
# Acepta dos formas: un path HOST (empieza con $TERMUX_ROOT, ej. $(pwd)) o
# un path GUEST absoluto (empieza con /, ej. /tmp, /home/x). Para un path
# host, el guest path se deriva eliminando el prefijo $TERMUX_ROOT/ (el guest
# ve /home/... no /data/data/com.termux/files/home/...). El check de abajo
# rechaza RW_DIR = "/" o = $TERMUX_ROOT exacto, así que el case host nunca
# produce un guest path vacío.
if [ -n "$RW_DIR" ]; then
    if [ "$RW_DIR" = "/" ] || [ "$RW_DIR" = "$TERMUX_ROOT" ]; then
        echo "error: --rw-dir no puede ser / (el sandbox completo no puede ser RW)" >&2
        exit 1
    fi
    if [ "$TERMUX_PATHS" = "1" ]; then
        # En termux-paths host==guest: el path real ya ES el guest path
        # (binds directos), no hay jerarquía que traducir.
        HOST_RW_DIR="$RW_DIR"
        GUEST_RW_DIR="$RW_DIR"
    else
        case "$RW_DIR" in
            "$TERMUX_ROOT"|"$TERMUX_ROOT"/*)
                # Path HOST: usar tal cual, traducido a guest para el bind
                HOST_RW_DIR="$RW_DIR"
                GUEST_RW_DIR="/${RW_DIR#$TERMUX_ROOT/}" ;;
            /*)
                # Path GUEST absoluto: mapea a su host bajo el rootfs
                HOST_RW_DIR="$TERMUX_ROOT$RW_DIR"
                GUEST_RW_DIR="$RW_DIR" ;;
            *)
                echo "error: --rw-dir requiere un path absoluto guest, ej. /tmp" >&2
                exit 1 ;;
        esac
    fi
    if [ ! -d "$HOST_RW_DIR" ]; then
        if [ "$VERBOSE" = "1" ]; then
            echo "[sandbox] creando dir RW: $HOST_RW_DIR" >&2
        fi
        mkdir -p "$HOST_RW_DIR" 2>/dev/null || {
            echo "error: no se pudo crear $HOST_RW_DIR" >&2
            exit 1
        }
    fi
fi

# Binds del runtime de Termux: RW en modo normal; :ro en modo estricto.
# El rootfs host ($TERMUX_ROOT) NO tiene /bin /etc /lib /tmp /var /share a
# nivel raíz (solo apps/ data/ home/ usr/): esos dirs vienen ÚNICAMENTE de
# estos binds, por eso NO se omiten en modo estricto (se congelan con :ro).
if [ "$TERMUX_PATHS" = "1" ]; then
    # Modo termux-paths: binds DIRECTOS host==guest (los paths se ven como en
    # Termux real). Sin rootfs: el resto del host Android queda inaccesible
    # por permisos (u0_a379 no puede enumerar / del host). En modo estricto
    # usr y home se congelan :ro y no hay bind "/" ro (sin rootfs).
    if [ -n "$RW_DIR" ]; then
        runtime_binds="\
  --bind=$TERMUX_PREFIX:$TERMUX_PREFIX:ro \
  --bind=$TERMUX_ROOT/home:$TERMUX_ROOT/home:ro \
  --bind=$TERMUX_PREFIX/bin:/bin:ro \
  --bind=$TERMUX_PREFIX/bin:/usr/bin:ro"
        strict_binds="\
  --bind=$HOST_RW_DIR:$GUEST_RW_DIR:rw"
    else
        runtime_binds="\
  --bind=$TERMUX_PREFIX:$TERMUX_PREFIX \
  --bind=$TERMUX_ROOT/home:$TERMUX_ROOT/home \
  --bind=$TERMUX_PREFIX/bin:/bin:ro \
  --bind=$TERMUX_PREFIX/bin:/usr/bin:ro"
        strict_binds=""
    fi
elif [ -n "$RW_DIR" ]; then
    runtime_binds="\
  --bind=$TERMUX_PREFIX:/usr:ro \
  --bind=$TERMUX_PREFIX/bin:/bin:ro \
  --bind=$TERMUX_PREFIX/etc:/etc:ro \
  --bind=$TERMUX_PREFIX/lib:/lib:ro \
  --bind=$TERMUX_PREFIX/share:/share:ro \
  --bind=$TERMUX_PREFIX/tmp:/tmp:ro \
  --bind=$TERMUX_PREFIX/var:/var:ro"
    # RO global del rootfs (congela home, apps, data...) + único dir RW.
    # El bind RW va DESPUÉS del runtime :ro: para un guest path idéntico
    # proot mantiene el ÚLTIMO bind ("only the last binding is active").
    strict_binds="\
  --bind=$TERMUX_ROOT:/:ro \
  --bind=$HOST_RW_DIR:$GUEST_RW_DIR:rw"
else
    runtime_binds="\
  --bind=$TERMUX_PREFIX:/usr \
  --bind=$TERMUX_PREFIX/bin:/bin \
  --bind=$TERMUX_PREFIX/etc:/etc \
  --bind=$TERMUX_PREFIX/lib:/lib \
  --bind=$TERMUX_PREFIX/share:/share \
  --bind=$TERMUX_PREFIX/tmp:/tmp \
  --bind=$TERMUX_PREFIX/var:/var"
    strict_binds=""
fi

# Variables según el modo: env del sandbox, rootfs y bash inicial
if [ "$TERMUX_PATHS" = "1" ]; then
    sandbox_home="$TERMUX_ROOT/home"
    sandbox_prefix="$TERMUX_PREFIX"
    sandbox_path="$TERMUX_PREFIX/bin"
    sandbox_tmpdir="$TERMUX_PREFIX/tmp"
    sandbox_ld="$TERMUX_PREFIX/lib"
    sandbox_ssl="$TERMUX_PREFIX/etc/tls/cert.pem"
    sandbox_git_exec="$TERMUX_PREFIX/libexec/git-core"
    rootfs_arg=""
    guest_bash="$TERMUX_PREFIX/bin/bash"
else
    sandbox_home="/home"
    sandbox_prefix="/usr"
    sandbox_path="/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin"
    sandbox_tmpdir="/tmp"
    sandbox_ld="/usr/lib"
    sandbox_ssl="/etc/tls/cert.pem"
    sandbox_git_exec="/usr/libexec/git-core"
    rootfs_arg="--rootfs=$TERMUX_ROOT"
    guest_bash="/bin/bash"
fi

# Variables de toolchain no sensibles que suelen necesitar las aplicaciones
# interactivas (por ejemplo Neovim/LSP). El entorno general sigue siendo
# fail-closed mediante env -i; solo se propagan rutas existentes y se
# traducen al espacio guest cuando se usa un rootfs.
translate_host_path() {
    local requested="$1"

    if [ "$TERMUX_PATHS" = "1" ]; then
        printf '%s' "$requested"
        return 0
    fi

    case "$requested" in
        "$TERMUX_ROOT")
            printf '/'
            ;;
        "$TERMUX_ROOT"/*)
            printf '/%s' "${requested#"$TERMUX_ROOT/"}"
            ;;
        *)
            printf '%s' "$requested"
            ;;
    esac
}

toolchain_env=()
ANDROID_HOME_HOST="${ANDROID_HOME:-$TERMUX_ROOT/home/Android}"
if [ -d "$ANDROID_HOME_HOST" ]; then
    ANDROID_HOME_GUEST=$(translate_host_path "$ANDROID_HOME_HOST")
    toolchain_env+=("ANDROID_HOME=$ANDROID_HOME_GUEST")
    toolchain_env+=("ANDROID_SDK_ROOT=$ANDROID_HOME_GUEST")
fi

JAVA_HOME_HOST="${JAVA_HOME:-$TERMUX_PREFIX/lib/jvm/java-17-openjdk}"
if [ -d "$JAVA_HOME_HOST" ]; then
    JAVA_HOME_GUEST=$(translate_host_path "$JAVA_HOME_HOST")
    toolchain_env+=("JAVA_HOME=$JAVA_HOME_GUEST")
fi

# In termux-paths mode the aliases above preserve the conventional Termux
# shebangs without putting termux-exec's LD_PRELOAD on every child process.
# Rootfs mode already provides /bin and /usr/bin through the runtime binds.
guest_exec_prefix=""

# Preserve the shell selected by Termux for the no-command interactive mode.
# Only shells under the Termux prefix are translated into the rootfs guest;
# arbitrary host paths are rejected and fall back to bash.
guest_login_shell=""
case "$CONFIGURED_SHELL" in
    "$TERMUX_PREFIX"/*)
        shell_suffix="${CONFIGURED_SHELL#"$TERMUX_PREFIX"/}"
        if [ -x "$CONFIGURED_SHELL" ]; then
            if [ "$TERMUX_PATHS" = "1" ]; then
                guest_login_shell="$CONFIGURED_SHELL"
            else
                guest_login_shell="/usr/$shell_suffix"
            fi
        fi
        ;;
    /bin/*|/usr/bin/*)
        if [ "$TERMUX_PATHS" = "1" ] && [ -x "$TERMUX_PREFIX$CONFIGURED_SHELL" ]; then
            guest_login_shell="$TERMUX_PREFIX$CONFIGURED_SHELL"
        elif [ "$TERMUX_PATHS" != "1" ] && [ -x "$CONFIGURED_SHELL" ]; then
            guest_login_shell="$CONFIGURED_SHELL"
        fi
        ;;
esac
if [ -z "$guest_login_shell" ]; then
    if [ "$TERMUX_PATHS" = "1" ]; then
        guest_login_shell="$TERMUX_PREFIX/bin/bash"
    else
        guest_login_shell="/bin/bash"
    fi
fi

# Convierte una ruta absoluta del host Termux a la ruta que existe dentro del
# rootfs guest. En --termux-paths ambas rutas son idénticas. Esto permite usar
# directamente `--cwd "$PWD"` desde Termux sin filtrar /data/data/... como una
# ruta guest inexistente.
translate_cwd() {
    local requested="$1"

    if [ "$TERMUX_PATHS" = "1" ]; then
        printf '%s' "$requested"
        return 0
    fi

    case "$requested" in
        "$TERMUX_ROOT")
            printf '/'
            ;;
        "$TERMUX_ROOT"/*)
            printf '/%s' "${requested#"$TERMUX_ROOT/"}"
            ;;
        /*)
            # Ya es una ruta guest (por ejemplo /home o /tmp).
            printf '%s' "$requested"
            ;;
        *)
            # Las rutas relativas conservan la semántica nativa de PRoot:
            # se resuelven respecto al cwd heredado del proceso.
            printf '%s' "$requested"
            ;;
    esac
}

# Sin comando -> shell interactivo de login; con comando -> --cwd= traducido.
if [ -z "$cmd" ]; then
    if [ -n "$CWD_OVERRIDE" ]; then
        cwd_arg="--cwd=$(translate_cwd "$CWD_OVERRIDE")"
    elif [ "$TERMUX_PATHS" = "1" ]; then
        cwd_arg="--cwd=$TERMUX_ROOT/home"
    else
        cwd_arg="--cwd=/home"
    fi
    cmd="$guest_login_shell -i -l"
    if [ "$VERBOSE" = "1" ]; then
        echo "[sandbox] Termux aislado — shell interactivo (--help para opciones)" >&2
    fi
else
    if [ -n "$CWD_OVERRIDE" ]; then
        cwd_arg="--cwd=$(translate_cwd "$CWD_OVERRIDE")"
    elif [ "$TERMUX_PATHS" = "1" ]; then
        cwd_arg="--cwd=."
    elif [ "$PWD" = "$TERMUX_ROOT" ]; then
        cwd_arg="--cwd=/"
    elif [ "${PWD#$TERMUX_ROOT/}" != "$PWD" ]; then
        cwd_arg="--cwd=/${PWD#$TERMUX_ROOT/}"
    else
        cwd_arg="--cwd=/home"
    fi
    if [ "$VERBOSE" = "1" ]; then
        echo "[sandbox] Termux aislado — prefijo de Termux y binds explícitos del launcher; /data y /storage no se usan; procesos host invisibles" >&2
    fi
fi

# Antepone los shims --as al PATH del sandbox (bionic no lee /etc/passwd)
if [ -n "$AS_USER" ]; then
    sandbox_path="$shim_path:$sandbox_path"
fi

# Ejecuta proot con aislamiento (9 flags) y binds del runtime de Termux
proc_isolated_arg=""
if [ "$PROC_ISOLATED" = "1" ]; then
    proc_isolated_arg="--proc-isolated"
fi

# In Termux-paths mode the host cwd must also be inside the app prefix. A
# runner may invoke this wrapper from a cwd outside the Termux app prefix;
# letting proot inherit it would turn that host path into a guest path before
# the explicit guest cwd is applied.
if [ "$TERMUX_PATHS" = "1" ] && [ -n "$CWD_OVERRIDE" ]; then
    cd "$TERMUX_PREFIX" || exit 1
fi

exec env \
  -i \
  HOME=$sandbox_home \
  PREFIX=$sandbox_prefix \
  PATH=$sandbox_path \
  TERM=${TERM:-xterm-256color} \
  LANG=${LANG:-en_US.UTF-8} \
  COLORTERM=${COLORTERM:-truecolor} \
  TMPDIR=$sandbox_tmpdir \
  PROOT_TMP_DIR=$TERMUX_PREFIX/tmp \
  PROOT_RUNTIME_DIR=$TERMUX_PREFIX/tmp \
  PROOT_VERBOSE=${PROOT_VERBOSE:-0} \
  LD_LIBRARY_PATH=$sandbox_ld \
  SSL_CERT_FILE=$sandbox_ssl \
  GIT_SSL_CAINFO=$sandbox_ssl \
  GIT_EXEC_PATH=$sandbox_git_exec \
  XDG_RUNTIME_DIR=$sandbox_tmpdir \
  $as_env \
  "${toolchain_env[@]}" \
  "$TERMUX_PREFIX/bin/proot" \
  --kill-on-exit \
  -L \
  $proc_isolated_arg \
  --ptrace-isolated \
  --bpf-isolated \
  --perf-isolated \
  --handle-isolated \
  --reboot-isolated \
  --swap-isolated \
  --kexec-isolated \
  --ioport-isolated \
  $rootfs_arg \
  $cwd_arg \
  --bind=/system:/system:ro \
  --bind=/vendor:/vendor:ro \
  --bind=/apex:/apex:ro \
  --bind=/linkerconfig/ld.config.txt:/linkerconfig/ld.config.txt:ro \
  $runtime_binds \
  $strict_binds \
  $storage_binds \
  $passwd_bind \
  --bind=/dev:/dev \
  --bind=/proc:/proc \
  $extra \
  "${PROOT_ARGS[@]}" \
  $guest_bash -c "$guest_exec_prefix$cmd"
